# Uploads and source archives
.uploads/
*.zip

# Target binaries and runtime data (never commit)
target/*
!target/.gitkeep
# Exception: preserve the original source archive as immutable evidence.
!target/source/
!target/source/*.zip

# Generated evidence and captures
artifacts/evidence/
artifacts/exports/
artifacts/snapshots/

# Analysis scratch space
analysis/**/tmp/
*.log
*.tmp

# Toolchain / caches
node_modules/
.tools/
__pycache__/
*.pyc
.DS_Store

# .NET build outputs
bin/
obj/
*.user

# Release packages
release/

# 内置 Python 运行时（体积大，由 scripts/make-release.sh 打入发布包）
runtime/

# TqSdk 账号配置：按用户要求随仓库保存，便于后续直接使用
