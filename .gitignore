# Uploads and source archives
.uploads/
*.zip

# Target binaries and runtime data (never commit)
target/*
!target/.gitkeep
# Exception: preserve the original source archive as immutable evidence.
!target/source/
!target/source/*.zip

# Generated evidence and captures
artifacts/evidence/
artifacts/exports/
artifacts/snapshots/

# Analysis scratch space
analysis/**/tmp/
*.log
*.tmp

# Toolchain / caches
node_modules/
.tools/
__pycache__/
*.pyc
.DS_Store

# .NET build outputs
bin/
obj/
*.user

# Release packages
release/

# Local TqSdk credentials (never commit)
config/tqsdk.local.json
tqsdk.local.json
