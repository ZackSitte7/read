# REA / Ghidra environment
# Usage: source config/rea/rea.env

export GHIDRA_INSTALL_DIR="/opt/ghidra/ghidra_12.1.4_PUBLIC"
export JAVA_HOME="/root/.local/share/mise/installs/java/25"

# Put the pinned Node.js (24.22.1) first on PATH when this file is sourced.
export NVM_DIR="${NVM_DIR:-/root/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  # shellcheck disable=SC1090
  . "$NVM_DIR/nvm.sh"
  nvm use 24.22.1 >/dev/null 2>&1 || true
fi
